# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev — no setup needed):
# DATABASE_URL=sqlite:///site.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost/myapartment

# ── Email (Gmail) ─────────────────────────────────────────────────────────────
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your-gmail-app-password   # Use an App Password, not your real password
ADMIN_EMAIL=youraddress@gmail.com

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── iCal Sync ────────────────────────────────────────────────────────────────
ICAL_SYNC_INTERVAL_MINUTES=30

# ── Smart Access / Shelly (Cloud Control API) ────────────────────────────────
# Reach the Shelly from any cloud-hosted server, addressed by device ID (no local IP needed).
# Get "Server" and "Auth key" from the Shelly app → User settings → Authorization cloud key.
# In cloud mode the Smart Access page "Shelly Host" should hold the device ID (e.g. 98a31678b358).
SHELLY_CLOUD_SERVER=shelly-274-eu.shelly.cloud
SHELLY_CLOUD_KEY=your-authorization-cloud-key
SHELLY_DEVICE_ID=98a31678b358

# ── Nuki Smart Lock (Apartment Door) ───────────────────────────────────────────
# Get the Web API token at https://web.nuki.io → Settings → API.
# Find your Smart Lock ID with: curl -s "https://api.nuki.io/smartlock" -H "Authorization: Bearer <token>"
# On startup these override the Smart Access admin page for Nuki.
NUKI_SMARTLOCK_ID=123456789
NUKI_WEB_TOKEN=your-nuki-web-api-token
NUKI_WEB_BASE_URL=https://api.nuki.io
NUKI_UNLOCK_ACTION=unlatch   # unlatch = opens the door; unlock = just turns the cylinder

# ── Italian Compliance Codes (CIN/CIR) ────────────────────────────────────────
CIN_CODE=IT058091C2TXZ44TA6
CIR_CODE=058091-LOC-19856

# ── ROSS1000 (Regione Lazio SOAP Web Service) ─────────────────────────────────
# Set these as env variables in Railway (do NOT commit real values to git).
# ROSS1000_USERNAME=your-ross1000-username
# ROSS1000_PASSWORD=your-ross1000-password
ROSS1000_STRUCTURE_CODE=058091-LOC-19856  # e.g. 058091-LOC-19856
ROSS1000_PRODUCT=CAV   # defaults to CAV
ROSS1000_ENDPOINT=https://lazioturismo.ross1000.it/ws/checkinV2

# ── Guest Wi-Fi (QR card) ──────────────────────────────────────────────────────
# Shows SSID + password and a scan-to-connect QR on the guest portal/access pages.
# Set here (or in the /admin/wifi panel) — env values override on every startup.
WIFI_SSID=Your-Guest-Network-Name
WIFI_PASSWORD=your-guest-wifi-password
# WPA (default), WEP, or nopass for an open network
WIFI_SECURITY=WPA
# Optional label shown on the card, e.g. "2.4GHz & 5GHz" or "Guest". Leave empty to hide.
WIFI_BAND=Guest
# Set to true if the SSID is hidden / not broadcast.
WIFI_HIDDEN=false

# ── App base URL (used for Stripe redirect URLs) ──────────────────────────────
BASE_URL=http://localhost:5000